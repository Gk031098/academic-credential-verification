# Copy this file to client/.env.
# Leave out the blockchain lines to use local Ganache instead of Sepolia.
REACT_APP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
REACT_APP_NETWORK_ID=11155111
REACT_APP_NETWORK_NAME=Sepolia
REACT_APP_PINATA_JWT=your_pinata_upload_only_jwt
REACT_APP_IPFS_GATEWAY=https://your-gateway.mypinata.cloud/ipfs/
REACT_APP_PUBLIC_URL=https://academic-credential-verification-nu.vercel.app